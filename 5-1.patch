+    async def afirst(self) -> _All | None:
+        queryset = self
+        if not queryset.ordered:
+            queryset._check_ordering_first_last_queryset_aggregation(method="first")
+            queryset = queryset.order_by("pk")
+
+        async for obj in cast(Self, queryset[:1]).aiterator(chunk_size=1):
+            return obj
+        return None
+
+    async def alast(self) -> _All | None:
+        queryset = self
+        if queryset.ordered:
+            queryset = queryset.reverse()
+        else:
+            queryset._check_ordering_first_last_queryset_aggregation(method="last")
+            queryset = queryset.order_by("-pk")
+
+        async for obj in cast(Self, queryset[:1]).aiterator(chunk_size=1):
+            return obj
+        return None
+
+    async def aiterator(self, chunk_size: int = 2000) -> AsyncIterator[_All]:
+        async for item in super().aiterator(chunk_size=chunk_size):
