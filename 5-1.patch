+    async def aget(self, *args: Any, **kwargs: Any) -> _All:
+        if self.query.combinator and (args or kwargs):
+            raise NotSupportedError(
+                f"Calling QuerySet.get(...) with filters after {self.query.combinator}() is not supported."
+            )
+
+        clone = self._chain() if self.query.combinator else self.filter(*args, **kwargs)
+        if self.query.can_filter() and not self.query.distinct_fields:
+            clone = clone.order_by()
+
+        limit = 21
+        limited = not clone.query.select_for_update or connections[
+            clone.db
+        ].features.supports_select_for_update_with_limit
+        if limited:
+            clone.query.set_limits(high=limit)
+
+        results: list[_All] = []
+        async for obj in clone.aiterator(chunk_size=limit):
+            results.append(obj)
+            if limited and len(results) >= limit:
+                break
+
+        num = len(results)
+        if num == 1:
+            return results[0]
+        if not num:
+            raise self.model.DoesNotExist(
+                f"{self.model._meta.object_name} matching query does not exist."
+            )
+
+        num_repr: int | str = num
+        if limited and num >= limit:
+            num_repr = f"more than {limit - 1}"
+        raise self.model.MultipleObjectsReturned(
+            f"get() returned more than one {self.model._meta.object_name} -- it returned {num_repr}!"
+        )
